# ==========================================================================
# Git Ignore Configuration - Bang Yai Child Development Center MIS
# Prevents sensitive environment variables & credentials from GitHub
# ==========================================================================

# Environment variables & Sensitive Keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Supabase Local & Secrets
supabase/.temp/
.supabase/
*.sql
supabase_schema_complete.sql
seed*.sql
schema*.sql

# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build & Bundles
.next/
out/
build/

dist/

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary Logs & Debug Files
*.log
logs/
temp/
tmp/
